NODE_ENV=production
# Use the port assigned to this application by SPanel. Existing Counter API: 3134.
PORT=3134
HOST=127.0.0.1
TRUSTED_PROXIES=127.0.0.1,::1
DATABASE_TRANSPORT=tcp
DATABASE_URL=postgresql://counter_app:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/counter
DB_POOL_MAX=5
DB_TIMEOUT_MS=10000
JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
MFA_ENCRYPTION_KEY=REPLACE_WITH_A_SEPARATE_64_CHARACTER_HEX_KEY
REQUIRE_ADMIN_MFA=true
CORS_ORIGIN=https://counterpos.app-playground.co.uk
PUBLIC_APP_URL=https://counterpos.app-playground.co.uk
PLATFORM_ADMIN_EMAILS=REPLACE_WITH_YOUR_OWNER_LOGIN_EMAIL
# Confirm local Exim submission/authentication details with ScalaHosting.
SMTP_URL=smtp://127.0.0.1:25
MAIL_FROM=Counter <counter@REPLACE_WITH_YOUR_DOMAIN>
RUN_MIGRATIONS=false
SEED_SHOWCASE=false
